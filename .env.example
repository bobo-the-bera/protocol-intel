# Secrets: fill these in locally or in GitHub Actions secrets; never commit .env.
POSTGRES_PASSWORD=
DATABASE_URL=
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Each daemon role is deliberately disabled until you configure and baseline it.
COLLECTION_ENABLED=false
ANALYSIS_ENABLED=false
NOTIFICATIONS_ENABLED=false
DAILY_DIGEST_ENABLED=false
DAILY_DIGEST_HOUR_UTC=8
# Actions sets 72; an existing DB deadline cannot be extended by changing this value.
PILOT_HOURS=0
OPENAI_DEEP_MODEL=gpt-5.6-sol
OPENAI_DEEP_REASONING_EFFORT=medium
OPENAI_SCREEN_MODEL=gpt-5.6-luna
OPENAI_SCREEN_REASONING_EFFORT=low
SCREEN_MAX_OUTPUT_TOKENS=2000
DEEP_MAX_OUTPUT_TOKENS=6000
ANALYSIS_REQUEST_MAX_BYTES=48000
ANALYSIS_AUDIT_PERCENT=2
TELEGRAM_ALERT_MIN_IMPORTANCE=HIGH
CONFIG_DIR=config
CLUSTER_SECONDS=600
HTTP_CONCURRENCY=20
PER_HOST_CONCURRENCY=2

# The local backend uses the durable Docker volume; use s3 for R2 or S3.
BLOB_BACKEND=local
BLOB_DIR=data/blobs
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
