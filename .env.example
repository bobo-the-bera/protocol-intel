# Secrets: fill these in locally or in GitHub Actions secrets; never commit .env.
POSTGRES_PASSWORD=
DATABASE_URL=
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Each daemon role is deliberately disabled until you configure and baseline it.
COLLECTION_ENABLED=false
ANALYSIS_ENABLED=false
NOTIFICATIONS_ENABLED=false
OPENAI_DEEP_MODEL=gpt-5.6-sol
OPENAI_DEEP_REASONING_EFFORT=high
CONFIG_DIR=config
CLUSTER_SECONDS=600
HTTP_CONCURRENCY=20
PER_HOST_CONCURRENCY=2

# The local backend uses the durable Docker volume; use s3 for R2 or S3.
BLOB_BACKEND=local
BLOB_DIR=data/blobs
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
